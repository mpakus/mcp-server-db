MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=reader
MYSQL_PASS=replace-me
MYSQL_DB=app
MYSQL_POOL_SIZE=10
MYSQL_QUERY_TIMEOUT=30000
# MCP_REQUEST_TIMEOUT=31000
# MCP_MAX_INFLIGHT=4
# MCP_MAX_SESSIONS=1000
# MCP_SESSION_IDLE_TIMEOUT=300000
# MCP_MAX_RESPONSE_BYTES=8388608
ALLOW_INSERT_OPERATION=false
ALLOW_UPDATE_OPERATION=false
ALLOW_DELETE_OPERATION=false
ALLOW_DDL_OPERATION=false
ENABLE_PII_REDACTION=false
# MYSQL_CONNECTION_STRING=mysql://reader:replace-me@127.0.0.1:3306/app
# MYSQL_SOCKET_PATH=/tmp/mysql.sock
# MYSQL_SSL=true
# MYSQL_SSL_CA=/absolute/path/ca.pem
# MYSQL_SSL_CERT=/absolute/path/client-cert.pem
# MYSQL_SSL_KEY=/absolute/path/client-key.pem
# SCHEMA_UPDATE_PERMISSIONS=development:true,production:false
# IS_REMOTE_MCP=true
# REMOTE_SECRET_KEY=replace-with-a-long-secret
# PORT=3000

# Optional private snapshots for the separate status/resources CLI.
MCP_DASHBOARD=false
# MCP_DASHBOARD_DIR=/absolute/private/path

# Optional query-result cache. Also pass cache: true on each suitable read.
MCP_CACHE_ENABLED=false
# MCP_CACHE_TTL_MS=5000
# MCP_CACHE_MAX_ENTRIES=1000
# MCP_CACHE_MAX_ENTRY_BYTES=65536
