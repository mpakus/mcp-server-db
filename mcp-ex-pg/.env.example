PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=reader
PG_PASS=replace-me
PG_DB=app
PG_SCHEMA=public
PG_POOL_SIZE=10
PG_QUERY_TIMEOUT=30000
ALLOW_INSERT_OPERATION=false
ALLOW_UPDATE_OPERATION=false
ALLOW_DELETE_OPERATION=false
ALLOW_DDL_OPERATION=false
ENABLE_PII_REDACTION=false
# PG_CONNECTION_STRING=postgres://reader:replace-me@127.0.0.1:5432/app
# PG_SOCKET_PATH=/tmp
# PG_SSL=true
# PG_SSL_CA=/absolute/path/ca.pem
# PG_SSL_CERT=/absolute/path/client-cert.pem
# PG_SSL_KEY=/absolute/path/client-key.pem
# SCHEMA_UPDATE_PERMISSIONS=development:true,production:false
# IS_REMOTE_MCP=true
# REMOTE_SECRET_KEY=replace-with-a-long-secret
# PORT=3001

# Optional private snapshots for the separate status/resources CLI.
MCP_DASHBOARD=false
# MCP_DASHBOARD_DIR=/absolute/private/path
